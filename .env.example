# Khan's Bike Zone API — environment configuration.
# Copy to .env for local dev. cmd/api reads process environment directly;
# scripts/dev-up sources this file. Config parsing fails fast at startup and
# reports EVERY invalid/missing variable at once (see internal/config).

# ---- Runtime ----------------------------------------------------------------
APP_ENV=development                 # development | production (controls log handler + cookie flags)
HTTP_ADDR=127.0.0.1:8080            # host:port the API listens on; TLS is terminated by the tunnel
PUBLIC_BASE_URL=https://khansbikezone.example   # absolute base URL used to build media/canonical links

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgres://bikezone:bikezone@127.0.0.1:5432/bikezone?sslmode=disable
DB_MAX_CONNS=20
# If a native Postgres already owns host port 5432, start the dev container on an
# alternate host port and point DATABASE_URL at it:
#   POSTGRES_HOST_PORT=5433 docker compose up -d   (then use ...@127.0.0.1:5433/...)
POSTGRES_HOST_PORT=5432                     # pgxpool max connections

# ---- Auth / sessions --------------------------------------------------------
SESSION_COOKIE_NAME=bz_session
SESSION_TTL=720h                    # Go duration; how long a session cookie is valid
CSRF_KEY=                           # REQUIRED: 32 random bytes, base64-encoded (openssl rand -base64 32)

# ---- Media ------------------------------------------------------------------
MEDIA_BACKEND=fs                    # fs | r2
MEDIA_FS_ROOT=D:\bikezone\media     # root dir for the content-addressed fs blobstore (MEDIA_BACKEND=fs)
MEDIA_MAX_UPLOAD_BYTES=26214400     # 25 MiB hard cap on a single upload
MEDIA_MAX_PIXELS=50000000           # decode guard against pixel-bomb images (~50 MP)
MEDIA_RENDITION_WIDTHS=320,640,960,1280,1920   # widths generated for each ready asset

# ---- R2 (only used when MEDIA_BACKEND=r2) -----------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=

# ---- Email (mailing-list double opt-in confirmation) ------------------------
EMAIL_BACKEND=log                   # log | smtp. 'log' prints the confirm link and sends nothing (dev default)
EMAIL_FROM=                         # sender address, e.g. hello@khansbikezone.example (required when smtp)
EMAIL_FROM_NAME=Khan's Bike Zone
SMTP_HOST=                          # required when EMAIL_BACKEND=smtp
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Worker (in-process job runner) -----------------------------------------
WORKER_ENABLED=true                 # run the job worker pool inside cmd/api
WORKER_CONCURRENCY=2

# ---- Network / logging ------------------------------------------------------
TRUST_CLOUDFLARE_IPS=true           # trust CF-Connecting-IP only from Cloudflare ranges
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text
